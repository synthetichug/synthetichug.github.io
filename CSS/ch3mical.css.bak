#content {
   position: relative;
   width: 790px;
   padding-bottom: 135px;
}


#primary_content {
   padding-left: 205px;
   padding-top: 30px;
   padding-right: 40px;
   width: 325px;
}

.quiz-container{
	position: relative;
	height: 200px;
	margin-top: 40px;
}
.quiznav {
	
	text-align:center;  
	overflow: hidden;
	background-color: #3d464e;
	color: #e64000;
}
.quiznav a {
	user-select:none;
	float: center;
	font-weight: bold;
	text-align: center;
	padding: 30px 15px;
	
}
.quiznav a:hover {
	background-color: #4e5964;
} 
.quiznav b{
	font-size: 15px;
	text-align: right;
	float: right;
	padding: 20px 15px;
}
.slide{
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	z-index: 1;
	opacity: 0;
	transition: opacity 0.5s;
}
.active-slide{
	opacity: 1;
	z-index: 2;
}
.question{
	font-size: 30px;
	margin-left: 150px;
	margin-right: 150px;
	margin-bottom: 30px;
}
.answers {
	margin-left: 150px;
	margin-right: 150px;
	margin-bottom: 30px;
	display: inline-block;
}
.answers label{
	display: block;
	margin-bottom: 10px;
}
.explaination{
	margin-left: 150px;
	margin-right: 150px;
}
.frac {
	user-select:none;
    display: inline-block;
    position: relative;
    vertical-align: middle;
    letter-spacing: 0.001em;
    text-align: center;
}
.frac > span {
    display: block;
    padding: 0.1em;
}
.frac span.bottom {
    border-top: thin solid black;
}
.frac span.symbol {
    display: none;
} 
