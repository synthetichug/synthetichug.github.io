body {
	background: #1f2327 url(C:/Users/user/Desktop/Ch3mical/Media/footer.png) repeat-x bottom left;
	min-width: 1036px;
	font-family: "Helvetica Neue", Arial, sans-serif;
}

#container h1 {
   display: block;
   width: 210px; height: 104px;
   margin-left: 130px;
	background: url(C:/Users/user/Desktop/Ch3mical/Media/logo.png);
	text-indent: -9999px;
}

/*
#container h1 a:hover {
   background-position-y: -104px;
}
*/

#centerwell {
   position: relative;
   height: 177px;
   background: #3d464e;
   overflow: hidden;
}

#centerwell li  {
   position: relative;
   width: 72px; height: 177px;
   float: left;
   border-right: #3d464e 1px solid;
   background: white;
   overflow: hidden;
   cursor: pointer;
}

#centerwell h3 {
   position: absolute;
   top: 0; left: 0;
   text-indent: -9999px;
   width: 72px; height: 177px;
}

#centerwell p {
   width: 215px;
   margin-left: 85px;
   margin-top: 50px;
   padding-top: 40px;
   color: #5f5f5f;
   font-size: 15px;
   line-height: 18px;
   font-family: GeogrotesqueMedium, Helvetica, Arial, sans-serif;
   letter-spacing: 0pt;

}

/* ADDING IMAGES PER SECTIONS FOR GLOBAL NAV*/
